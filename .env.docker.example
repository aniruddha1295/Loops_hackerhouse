# ===========================================
# Optional settings for the Docker image — copy to .env (local)
# or add as environment variables on your host (Render / Hugging Face)
# The image runs without any of these; the demo data is built in.
# ===========================================

# Public HTTPS URL of the deployment
PUBLIC_URL=http://localhost:8080

# ElevenLabs (agent ID is also needed at build time for the call widget)
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Web3 / Filecoin (optional — leave empty to skip uploads + attestations)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
FILECOIN_RPC_URL=https://api.calibration.node.glif.io/rpc/v1
CLAIM_REGISTRY_ADDRESS=
EAS_CONTRACT_ADDRESS=
EAS_SCHEMA_UID=
EAS_SCHEMA=
AGENT_ID=1
AGENT_PRIVATE_KEY=
