# Single entry point (runs as a non-root user; ${PORT} filled in by start.sh)
#   /                  React dashboard
#   /api/, /health     Fastify backend
#   /rest/v1/          PostgREST (what supabase-js .from() calls)

worker_processes 1;
pid /tmp/nginx.pid;
error_log stderr warn;

events {
  worker_connections 512;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log off;
  sendfile on;

  client_body_temp_path /tmp/nginx-body;
  proxy_temp_path /tmp/nginx-proxy;
  fastcgi_temp_path /tmp/nginx-fastcgi;
  uwsgi_temp_path /tmp/nginx-uwsgi;
  scgi_temp_path /tmp/nginx-scgi;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  server {
    listen ${PORT};
    root /app/web;
    client_max_body_size 20m;

    # Live dashboard stream: no buffering, long-lived
    location = /api/events {
      proxy_pass http://127.0.0.1:3005;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 1h;
    }

    location /api/ {
      proxy_pass http://127.0.0.1:3005;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_read_timeout 120s;
    }

    location = /health {
      proxy_pass http://127.0.0.1:3005;
    }

    location = /version {
      proxy_pass http://127.0.0.1:3005;
    }

    # supabase-js sends its key as a JWT; drop it so every request runs as `anon`
    location /rest/v1/ {
      proxy_pass http://127.0.0.1:3000/;
      proxy_set_header Authorization "";
    }

    location /assets/ {
      expires 1y;
      add_header Cache-Control "public, immutable";
    }

    location / {
      try_files $uri $uri/ /index.html;
    }
  }
}
